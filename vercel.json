{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/2/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, must-revalidate"
        }
      ]
    },
    {
      "source": "/2/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/2/pdf/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/4-1/kenkyu/:path*",
      "destination": "/kenkyu/:path*",
      "permanent": true
    },
    {
      "source": "/4-1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/4-1/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(1|3|4|5)/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(1|3|4|5)",
      "destination": "/",
      "permanent": true
    }
  ]
}