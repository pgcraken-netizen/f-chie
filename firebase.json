{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "vercel.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "api/**",
      "tools/**",
      ".github/**"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, must-revalidate"
          }
        ]
      },
      {
        "source": "/{css,js}/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/2/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, must-revalidate"
          }
        ]
      },
      {
        "source": "/2/{css,js}/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/2/pdf/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/4-1/kenkyu/**",
        "destination": "/kenkyu/",
        "type": 301
      },
      {
        "source": "/4-1",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/4-1/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/2",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/2/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/1",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/1/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/3",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/3/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/4",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/4/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/5",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/5/**",
        "destination": "/",
        "type": 301
      }
    ]
  }
}